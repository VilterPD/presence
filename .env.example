# =========================
# Core
# =========================
# primary | backup
ROLE=primary

DB_PATH=/data/presence.db
INIT_DB=1

# =========================
# Absence (Hawk auth)
# =========================
ABSENCE_BASE_URL=https://app.absence.io
ABSENCE_API_ID=your_absence_api_id
ABSENCE_API_KEY=your_absence_api_key

# =========================
# 3CX (OAuth service principal)
# =========================
THREECX_PBX_FQDN=example.my3cx.de
THREECX_CLIENT_ID=presence
THREECX_CLIENT_SECRET=your_3cx_client_secret

# =========================
# Polling / behaviour
# =========================
# Legacy global interval (fallback)
SYNC_INTERVAL_SECONDS=300

# Day / night behaviour
DAY_START_HOUR=7
DAY_END_HOUR=20
INTERVAL_DAY_SECONDS=60
INTERVAL_NIGHT_SECONDS=600

# =========================
# Profiles
# =========================
THREECX_PROFILE_AVAILABLE=Available
THREECX_PROFILE_AWAY=Away

# =========================
# Exclusions
# =========================
# Comma-separated, lowercase recommended
EXCLUDE_EMAILS=
EXCLUDE_EXTENSIONS=

# =========================
# Health / failover (watcher.py)
# =========================
# REQUIRED on backup, empty on primary
PRIMARY_HOST=

# Health server port (health.py)
HEALTH_PORT=49317

# Watcher timing (seconds)
CHECK_INTERVAL=10
FAILOVER_AFTER=60
FAILBACK_AFTER=600

# =========================
# Debug / safety
# =========================
SYNC_DRY_RUN=false
